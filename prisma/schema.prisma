generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MENTOR
  STUDENT
  HOD
}

model Department {
  id              String    @id @default(cuid())
  name            String
  users           User[]
  students        Student[]
  alertThresholds Json?
}

model User {
  id              String             @id @default(cuid())
  name            String
  mobile          String             @unique
  role            Role
  departmentId    String
  department      Department         @relation(fields: [departmentId], references: [id])
  student         Student?
  assignments     MentorAssignment[]
  meetings        Meeting[]
  followUps       FollowUp[]
  alertThresholds Json?
  reviews         WeeklyReview[]
}

model Student {
  id           String             @id @default(cuid())
  rollNo       String             @unique
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id])
  departmentId String
  department   Department         @relation(fields: [departmentId], references: [id])
  assignments  MentorAssignment[]
  attendance   AttendanceRecord[]
  marks        InternalMark[]
  lmsActivity  LmsActivity[]
  meetings     Meeting[]
  followUps    FollowUp[]
  reviews      WeeklyReview[]
}

model WeeklyReview {
  id         String   @id @default(cuid())
  mentorId   String
  mentor     User     @relation(fields: [mentorId], references: [id])
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  weekStart  DateTime @db.Date
  reviewedAt DateTime @default(now())

  @@unique([mentorId, studentId, weekStart])
  @@index([mentorId, weekStart])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  recordId  String
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

model MentorAssignment {
  id        String  @id @default(cuid())
  mentorId  String
  mentor    User    @relation(fields: [mentorId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([mentorId, studentId])
  @@index([mentorId])
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  subject   String
  weekStart DateTime @db.Date
  attended  Int
  total     Int

  @@unique([studentId, subject, weekStart])
  @@index([studentId])
}

model InternalMark {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  subject    String
  assessment String
  assessedOn DateTime @db.Date
  score      Float
  maxScore   Float

  @@unique([studentId, subject, assessment])
  @@index([studentId])
}

model LmsActivity {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  activityOn DateTime @db.Date
  events     Int

  @@unique([studentId, activityOn])
  @@index([studentId])
}

model Meeting {
  id                 String     @id @default(cuid())
  clientSubmissionId String     @unique
  mentorId           String
  mentor             User       @relation(fields: [mentorId], references: [id])
  studentId          String
  student            Student    @relation(fields: [studentId], references: [id])
  meetingDate        DateTime   @db.Date
  language           String
  summary            String
  topics             String[]
  confirmedAt        DateTime
  createdAt          DateTime   @default(now())
  followUps          FollowUp[]

  @@index([studentId])
  @@index([mentorId])
}

model FollowUp {
  id          String    @id @default(cuid())
  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id])
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  mentorId    String
  mentor      User      @relation(fields: [mentorId], references: [id])
  action      String
  dueDate     DateTime  @db.Date
  completedAt DateTime?

  @@index([studentId])
  @@index([mentorId])
}

model AutomationSettings {
  departmentId      String @id
  enabled           Boolean @default(true)
  meetingGapDays    Int @default(21)
  escalationDays    Int @default(7)
  staleDataDays     Int @default(14)
  updatedAt         DateTime @updatedAt
}

model AutomationNotice {
  id           String @id @default(cuid())
  key          String @unique
  departmentId String
  userId       String
  studentId    String?
  kind         String
  title        String
  body         Json
  createdAt    DateTime @default(now())
  readAt       DateTime?
  resolvedAt   DateTime?

  @@index([userId, createdAt])
  @@index([departmentId, kind])
}

model StudentCheckIn {
  id          String @id @default(cuid())
  studentId   String
  weekStart   DateTime @db.Date
  progress    String @default("")
  support     String @default("")
  requestedAt DateTime @default(now())
  respondedAt DateTime?

  @@unique([studentId, weekStart])
  @@index([studentId, requestedAt])
}

model AutomationJob {
  id           String @id @default(cuid())
  key          String @unique
  departmentId String
  userId       String
  kind         String
  status       String @default("pending")
  dueAt        DateTime
  input        Json
  result       Json?
  artifact     Bytes?
  createdAt    DateTime @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([status, dueAt])
  @@index([userId, createdAt])
}

model AutomationLease {
  key       String @id
  holder    String
  expiresAt DateTime
}

model AutomationRun {
  id           String @id @default(cuid())
  departmentId String
  status       String
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  summary      Json?

  @@index([departmentId, startedAt])
}
