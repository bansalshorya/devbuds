   DATABASE_URL="paste-your-neon-connection-string-here"
   JWT_SECRET="change-me-to-a-long-random-string"
   DEMO_MODE="true"
   DEMO_OTP="123456"
   TRANSCRIBER="mock"
   EXTRACTOR="mock"

# Real Tamil/English transcription and AI extraction with Google AI Studio:
# Set TRANSCRIBER="gemini" and EXTRACTOR="gemini" above.
# Mock providers are allowed only when DEMO_MODE="true".
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TRANSCRIPTION_MODEL="gemini-2.5-flash"
GEMINI_EXTRACTION_MODEL="gemini-2.5-flash"

