+import { prisma } from "@/server/db/client";
+import { getCurrentUser } from "@/server/auth/session";
+import { sameOrigin } from "@/server/auth/origin";
+import { IMPORT_TYPES, parseCsv, type ImportType } from "@/server/import/csv";
+
+const MAX_BYTES = 2 * 1024 * 1024;
+
+export async function POST(req: Request) {
+  const user = await getCurrentUser();
+  if (!user || user.role !== "MENTOR") {
+    return Response.json({ errors: ["Not allowed"] }, { status: 403 });
+  }
+  if (!sameOrigin(req)) {
+    return Response.json({ errors: ["Not allowed"] }, { status: 403 });
+  }
+
+  const form = await req.formData().catch(() => null);
+  const type = form?.get("type");
+  const file = form?.get("file");
+  if (typeof type !== "string" || !IMPORT_TYPES.includes(type as ImportType) || !(file instanceof File)) {
+    return Response.json({ errors: ["Choose a data type and a CSV file"] }, { status: 400 });
+  }
+  if (file.size > MAX_BYTES) {
+    return Response.json({ errors: ["File is too large (max 2 MB)"] }, { status: 400 });
+  }
+
+  const parsed = parseCsv(type as ImportType, await file.text());
+  if (!parsed.ok) return Response.json({ errors: parsed.errors }, { status: 400 });
+
+  // A mentor can only update their own mentees (matched by roll number).
+  const mentees = await prisma.mentorAssignment.findMany({
+    where: { mentorId: user.id },
+    select: { student: { select: { id: true, rollNo: true } } },
+  });
+  const idByRoll = new Map(mentees.map((m) => [m.student.rollNo, m.student.id]));
+  const unknown = [...new Set(parsed.rows.map((r) => r.rollNo).filter((r) => !idByRoll.has(r)))];
+  if (unknown.length) {
+    return Response.json(
+      { errors: [`Roll numbers not in your mentee list: ${unknown.slice(0, 10).join(", ")}`] },
+      { status: 400 }
+    );
+  }
+
+  // All rows are saved together or not at all. Existing entries are updated, new ones added.
+  switch (parsed.type) {
+    case "attendance":
+      await prisma.$transaction(
+        parsed.rows.map((r) => {
+          const studentId = idByRoll.get(r.rollNo)!;
+          const weekStart = new Date(r.weekStart);
+          return prisma.attendanceRecord.upsert({
+            where: { studentId_subject_weekStart: { studentId, subject: r.subject, weekStart } },
+            update: { attended: r.attended, total: r.total },
+            create: { studentId, subject: r.subject, weekStart, attended: r.attended, total: r.total },
+          });
+        })
+      );
+      break;
+    case "marks":
+      await prisma.$transaction(
+        parsed.rows.map((r) => {
+          const studentId = idByRoll.get(r.rollNo)!;
+          const assessedOn = new Date(r.assessedOn);
+          return prisma.internalMark.upsert({
+            where: { studentId_subject_assessment: { studentId, subject: r.subject, assessment: r.assessment } },
+            update: { assessedOn, score: r.score, maxScore: r.maxScore },
+            create: { studentId, subject: r.subject, assessment: r.assessment, assessedOn, score: r.score, maxScore: r.maxScore },
+          });
+        })
+      );
+      break;
+    case "lms":
+      await prisma.$transaction(
+        parsed.rows.map((r) => {
+          const studentId = idByRoll.get(r.rollNo)!;
+          const activityOn = new Date(r.activityOn);
+          return prisma.lmsActivity.upsert({
+            where: { studentId_activityOn: { studentId, activityOn } },
+            update: { events: r.events },
+            create: { studentId, activityOn, events: r.events },
+          });
+        })
+      );
+      break;
+  }
+
+  return Response.json({ ok: true, imported: parsed.rows.length });
+}
